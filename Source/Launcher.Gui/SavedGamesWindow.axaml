<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Riel.Launcher.Gui"
        x:Class="Riel.Launcher.Gui.SavedGamesWindow"
        Title="{l:T 'Choose a saved game'}" Icon="/Assets/riel.png"
        Width="980" Height="620" MinWidth="680" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24,20">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
      <TextBlock Classes="heading" Text="{l:T 'Choose a saved game'}" />
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="{l:T 'Select a save to see its route, train, game time and screenshot.'}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,14,0,0">
      <WrapPanel Orientation="Horizontal">
        <WrapPanel.Styles>
          <Style Selector="Button"><Setter Property="Margin" Value="0,0,8,8" /></Style>
        </WrapPanel.Styles>
        <Button x:Name="DeleteButton" Content="{l:T 'Delete save'}" IsEnabled="False" />
        <Button x:Name="DeleteInvalidButton" Content="{l:T 'Delete invalid saves'}" />
        <Button x:Name="RestoreButton" Content="{l:T 'Restore deleted saves'}" />
        <Button x:Name="ImportButton" Content="{l:T 'Import save pack'}" />
        <Button x:Name="ExportButton" Content="{l:T 'Export save pack'}" IsEnabled="False" />
      </WrapPanel>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <WrapPanel.Styles>
          <Style Selector="Button"><Setter Property="Margin" Value="0,0,8,0" /></Style>
        </WrapPanel.Styles>
        <Button x:Name="ReplayPreviousButton" Content="{l:T 'Replay from previous save'}" IsEnabled="False" />
        <Button x:Name="ReplayStartButton" Content="{l:T 'Replay from start'}" IsEnabled="False" />
        <Button x:Name="CancelButton" Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="95" />
        <Button x:Name="ContinueButton" Content="{l:T 'Continue'}" Classes="accent"
                IsDefault="True" MinWidth="115" IsEnabled="False" />
      </WrapPanel>
    </StackPanel>
    <Grid ColumnDefinitions="*,300" ColumnSpacing="16">
      <ListBox x:Name="SaveList" Grid.Column="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="l:SavedGameItem">
            <StackPanel Margin="2,5" Spacing="3">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SavedAt}" Classes="secondary" />
              <TextBlock Text="{Binding Summary}" Classes="secondary small" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding FileName}" Classes="secondary small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1" Spacing="10">
        <Border Classes="panel" Height="190">
          <Grid>
            <Image x:Name="Screenshot" Stretch="Uniform" IsVisible="False" />
            <TextBlock x:Name="NoScreenshot" Text="{l:T 'No preview available'}"
                       Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>
        </Border>
        <TextBlock x:Name="SelectedDetails" TextWrapping="Wrap" />
        <TextBlock x:Name="SelectedFile" Classes="secondary small" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
