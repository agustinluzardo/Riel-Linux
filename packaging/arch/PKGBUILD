# Maintainer: Agustin Luzardo <agustinluzardo09@gmail.com>

pkgname=riel
pkgver=1.0.0
pkgrel=1
pkgdesc="Drive Microsoft Train Simulator routes natively on Linux, without Wine"
arch=('x86_64')
url="https://github.com/agustinluzardo/Riel-Linux"
license=('GPL-3.0-or-later')

depends=(
    'dotnet-runtime-10.0'
    # MonoGame's OpenGL backend talks to the display through SDL, and Riel's own display
    # enumeration and message boxes use it as well.
    'sdl2'
    # OpenAL Soft plays every sound.
    'openal'
    # Fontconfig resolves the font families the cab labels and the head-up display ask for.
    'fontconfig'
    'zlib'
    # The graphical launcher is Avalonia on X11 - XWayland under a Wayland session - and loads
    # these directly.
    'libglvnd'
    'libice'
    'libsm'
    'libx11'
    'libxcursor'
    'libxext'
    'libxfixes'
    'libxi'
    'libxrandr'
    # Native Riel editor suite (TSRE5vc-based).
    'qt6-base'
    'qt6-websockets'
    'qt6-wayland'
)
makedepends=('dotnet-sdk-10.0' 'git' 'cmake' 'ninja' 'python' 'qt6-tools')
optdepends=(
    'xdg-desktop-portal: the folder picker in the launcher, through the desktop dialog'
    'gtk3: the folder picker in the launcher, where there is no desktop portal'
    'vulkan-icd-loader: run the OpenGL renderer on Vulkan through Mesa zink'
    'ttf-liberation: metric compatible replacements for the fonts MSTS content names'
)

source=(
    "git+$url.git#branch=main"
    "tsre5vc::git+https://github.com/GokuMK/TSRE5vc.git#commit=15a5d148a15ad305e14a9e602961210ad18ada74"
)
sha256sums=('SKIP' 'SKIP')

# The compiled effects are committed in the repository. Producing them needs Microsoft's HLSL
# compiler, which does not run here, so building them at package time would mean pulling in Wine
# for something whose result is identical every time. See docs/linux/ARCHITECTURE.md.

_srcdir="Riel-Linux"
_install_dir="/usr/lib/$pkgname"

prepare() {
    cd "$srcdir/$_srcdir"
    # Nerdbank.GitVersioning derives the version from the history, which the clone above carries.
    git config --local advice.detachedHead false

    # Apply the same Riel product/settings integration used by portable CI.
    python scripts/prepare-route-editor-source.py "$srcdir/tsre5vc"
}

build() {
    cd "$srcdir/$_srcdir/Source"

    export DOTNET_CLI_TELEMETRY_OPTOUT=1
    export DOTNET_NOLOGO=1
    # Avalonia's build reports usage to its vendor; the project already switches that off, and
    # this makes sure of it.
    export AVALONIA_TELEMETRY_OPTOUT=1
    # Keep the restore inside the build directory so nothing is written to the user's home.
    export NUGET_PACKAGES="$srcdir/nuget"

    # Published one project at a time: publishing a solution to a shared output directory is
    # unsupported, and would drag the test projects along with it.
    local project
    for project in \
        ActivityRunner/ActivityRunner.csproj \
        Launcher.Cli/Launcher.Cli.csproj \
        Launcher.Gui/Launcher.Gui.csproj \
        MultiPlayer.Hub/MultiPlayer.Hub.csproj
    do
        dotnet publish "$project" \
            --configuration Release \
            --runtime linux-x64 \
            --self-contained false \
            --output "$srcdir/publish"
    done

    local riel_version
    riel_version="$(python -c 'import json; print(json.load(open("version.json"))["version"])')"
    cmake -S "$srcdir/tsre5vc" -B "$srcdir/route-editor-build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DTSRE5_VERSION="$riel_version" \
        -DTSRE_BUILD_ACE_TESTS=OFF \
        -DTSRE_BUILD_TOKEN_TESTS=OFF \
        -DTSRE_BUILD_SHAPE_TESTS=OFF \
        -DTSRE_BUILD_CONTENT_CASE_TESTS=OFF \
        -DTSRE_BUILD_GEO_TESTS=OFF
    cmake --build "$srcdir/route-editor-build" --parallel
}

check() {
    cd "$srcdir/$_srcdir/Source"

    export DOTNET_CLI_TELEMETRY_OPTOUT=1
    export DOTNET_NOLOGO=1
    export NUGET_PACKAGES="$srcdir/nuget"

    dotnet test Test/Tests.Orts/Tests.Orts.csproj --configuration Release
    dotnet test Test/Tests.Riel/Tests.Riel.csproj --configuration Release
}

package() {
    cd "$srcdir/$_srcdir"

    install -dm755 "$pkgdir$_install_dir"
    cp -r "$srcdir/publish/." "$pkgdir$_install_dir/"

    install -dm755 "$pkgdir$_install_dir/route-editor/bin"
    install -m755 "$srcdir/route-editor-build/TSRE5vc" \
        "$pkgdir$_install_dir/route-editor/bin/riel-route-editor-bin"
    install -m755 packaging/linux/riel-route-editor \
        "$pkgdir$_install_dir/route-editor/riel-route-editor"
    cp -r "$srcdir/tsre5vc/appdata" "$pkgdir$_install_dir/route-editor/"
    install -m644 packaging/linux/riel-route-editor.png \
        "$pkgdir$_install_dir/route-editor/riel-route-editor.png"
    install -m644 docs/route-editor.md \
        "$pkgdir$_install_dir/route-editor/README.md"

    # The publish output carries a runtimes/ tree for every platform MonoGame and Skia support.
    find "$pkgdir$_install_dir/runtimes" -mindepth 1 -maxdepth 1 \
        ! -name 'linux-x64' ! -name 'unix' -exec rm -rf {} + 2>/dev/null || true
    # Debug symbols are not needed at runtime.
    find "$pkgdir$_install_dir" -name '*.pdb' -delete

    install -Dm755 packaging/linux/riel "$pkgdir/usr/bin/riel"

    install -Dm644 packaging/linux/riel.desktop "$pkgdir/usr/share/applications/riel.desktop"
    install -Dm644 packaging/linux/riel-route-editor.desktop \
        "$pkgdir/usr/share/applications/riel-route-editor.desktop"
    install -Dm644 packaging/linux/70-raildriver.rules "$pkgdir/usr/lib/udev/rules.d/70-raildriver.rules"
    install -Dm644 packaging/linux/riel.6 "$pkgdir/usr/share/man/man6/riel.6"

    for size in 64 128 256; do
        if [ -f "packaging/linux/icons/${size}.png" ]; then
            install -Dm644 "packaging/linux/icons/${size}.png" \
                "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/riel.png"
        fi
        install -Dm644 "packaging/linux/route-editor-icons/${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/riel-route-editor.png"
    done

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 LICENSE "$pkgdir$_install_dir/route-editor/LICENSE-GPL-3.0.txt"
    install -m644 CREDITS.md "$pkgdir$_install_dir/route-editor/CREDITS.md"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/$pkgname/CREDITS.md"
    install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
    install -Dm644 docs/route-editor.md "$pkgdir/usr/share/doc/$pkgname/route-editor.md"
    cp -r docs "$pkgdir/usr/share/doc/$pkgname/docs"
    install -m644 CONTRIBUTING.md "$pkgdir/usr/share/doc/$pkgname/CONTRIBUTING.md"
    install -m644 LICENSE "$pkgdir/usr/share/doc/$pkgname/LICENSE"
    install -Dm644 docs/linux/INSTALL.md "$pkgdir/usr/share/doc/$pkgname/INSTALL.md"
    install -Dm644 docs/linux/ARCHITECTURE.md "$pkgdir/usr/share/doc/$pkgname/ARCHITECTURE.md"
}
